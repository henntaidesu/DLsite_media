<UserControl x:Class="R18MediaLibrary.Views.FanboxSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:R18MediaLibrary.Controls">
    <!-- 「作品搜索」分区里 FANBOX 来源的结果区（对齐 Web 端 src/Web/js/fanbox.js 的两个面板）。
         工具栏（来源下拉 + 输入框 + 查询 + 返回作家列表）由宿主 SearchPage 统一提供，本控件只管结果。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 选择操作条：仅作家主页显示 -->
        <Grid x:Name="SelectBar" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectInfo" VerticalAlignment="Center"
                       Style="{StaticResource CaptionText}" Text="已选 0 篇" />
            <!-- 监控这位作家：加入后按设定间隔轮询，有新作品自动下载 -->
            <Button x:Name="WatchToggleButton" Grid.Column="1" MinWidth="104" Margin="8,0,0,0"
                    Click="WatchToggle_Click" Content="+ 监控作家" />
            <Button x:Name="SelectAllButton" Grid.Column="2" MinWidth="72" Margin="8,0,0,0"
                    Click="SelectAll_Click" Content="全选" />
            <Button x:Name="SelectNoneButton" Grid.Column="3" MinWidth="72" Margin="8,0,0,0"
                    Click="SelectNone_Click" Content="清空" />
            <Button x:Name="DownloadSelectedButton" Grid.Column="4" MinWidth="110" Margin="8,0,0,0"
                    IsEnabled="False" Style="{StaticResource AccentButton}"
                    Click="DownloadSelected_Click" Content="下载选中" />
        </Grid>

        <Grid Grid.Row="1">
            <!-- 作家卡 / 作品卡共用同一个虚拟化换行网格（按当前层级填不同内容） -->
            <ListBox x:Name="CardList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Standard"
                     ScrollViewer.ScrollChanged="CardList_ScrollChanged"
                     SelectionChanged="CardList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 排布与媒体库作品卡一致（同 Web .grid.cards）：列宽下限 150、单行最多 8 列、
                             gap 12、卡片高宽比 1.5，列宽随窗口自适应 -->
                        <ctrl:VirtualizingWrapPanel MinItemWidth="150" MaxColumns="8"
                                                    ItemGap="12" ItemAspect="1.5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <!-- 卡片拉伸填满单元格；间距由网格自己排，容器不再带外边距 -->
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 结构对齐 Web 的 .card.mk：封面占卡片高度 2/3（.cover flex:2），
                             底部 1/3（.mk-foot）放标题 + 常驻操作按钮行。尺寸由网格给，卡片只管拉伸填满。 -->
                        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"
                                BorderThickness="1" BorderBrush="{Binding PickBorderBrush}"
                                Opacity="{Binding CardOpacity}" ToolTip="{Binding Title}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 封面：满幅按比例铺满裁切，无图时显示纯色底。
                                     图用 ImageBrush 画在带圆角的 Border 上——塞 Image 进去顶角会戳出卡片圆角 -->
                                <Grid ClipToBounds="True">
                                    <Border Background="#0CFFFFFF" CornerRadius="8,8,0,0" />
                                    <Border CornerRadius="8,8,0,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <!-- 角标：左上作家 public_id（吃剩余宽度、超出省略）/ 右上文件数·被收藏数（定长按需占位） -->
                                    <Grid VerticalAlignment="Top" Margin="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border HorizontalAlignment="Left"
                                                Background="#AA000000" CornerRadius="4" Padding="6,1"
                                                Visibility="{Binding TagVisibility}">
                                            <TextBlock Text="{Binding TagText}" Foreground="WhiteSmoke" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border Grid.Column="1" HorizontalAlignment="Right" Margin="6,0,0,0"
                                                Background="#AA000000" CornerRadius="4" Padding="6,1"
                                                Visibility="{Binding MetaVisibility}">
                                            <TextBlock Text="{Binding MetaText}" Foreground="WhiteSmoke" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                    <!-- 底部：已下载 / 下载中 -->
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="6"
                                            Background="#E66E6E7A" CornerRadius="4" Padding="6,1"
                                            Visibility="{Binding StateVisibility}">
                                        <TextBlock Text="{Binding StateText}" Foreground="WhiteSmoke"
                                                   FontSize="11" HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- 底部 1/3（Web .mk-foot）：标题占满剩余高度、超出省略；按钮行常驻在底 -->
                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- 最多两行、超出省略（Web .card.mk .wt 的 line-clamp: 2） -->
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Medium"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36"
                                               VerticalAlignment="Top" Margin="10,8,10,4" />

                                    <!-- 卡内常驻操作按钮行：对齐 Web 的 .mcard-actions（DLsite 作品卡同款）。
                                         未下载 [选择/已选][下载]，已下载/下载中为禁用的状态按钮，作家卡无按钮。 -->
                                    <Grid Grid.Row="1" Height="26" Margin="8,4,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource CardActionButton}"
                                                Visibility="{Binding SelectVisibility}"
                                                Background="{Binding PickBackground}"
                                                Foreground="{Binding PickForeground}"
                                                Content="{Binding PickText}"
                                                Click="PickButton_Click" />
                                        <Button Grid.Column="1" Margin="6,0,0,0"
                                                Style="{StaticResource CardActionButton}"
                                                Visibility="{Binding SelectVisibility}"
                                                Background="{StaticResource AccentBrush}"
                                                Foreground="White"
                                                ToolTip="只下载这一篇" Content="下载"
                                                Click="DownloadOne_Click" />
                                        <Button Grid.ColumnSpan="2" Style="{StaticResource CardActionButton}"
                                                Visibility="{Binding BusyVisibility}" IsEnabled="False"
                                                Content="{Binding StateText}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 作品详情（对齐 Web 的 fbDetailPane）：操作条 + 图集 + 字段 + 正文 + 其他附件。
                 结构照搬媒体库详情页（Web .detail > .dtop > .gallery + .fields）。 -->
            <ScrollViewer x:Name="DetailPane" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="DetailDownloadButton" MinWidth="110"
                                Style="{StaticResource AccentButton}"
                                Click="DetailDownload_Click" Content="下载本篇" />
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.6*" />
                                </Grid.ColumnDefinitions>

                                <!-- 图集：大图 + 缩略图条 -->
                                <StackPanel>
                                    <Border Background="#15151A" CornerRadius="8" MinHeight="140">
                                        <Image x:Name="DetailMainImage" Stretch="Uniform" MaxHeight="460"
                                               Cursor="Hand" MouseLeftButtonUp="DetailMainImage_Click" />
                                    </Border>
                                    <TextBlock x:Name="DetailNoImage" Text="这篇没有图片" Visibility="Collapsed"
                                               Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                                               HorizontalAlignment="Center" />
                                    <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="DetailThumbs">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,0" CornerRadius="5" BorderThickness="2"
                                                            BorderBrush="{Binding SelBorderBrush}"
                                                            Opacity="{Binding SelOpacity}">
                                                        <Image Source="{Binding Thumb}" Height="54" Stretch="Uniform"
                                                               Cursor="Hand" MouseLeftButtonUp="DetailThumb_Click" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- 字段（作家 / 发布 / 标签 / 文件 / 状态） -->
                                <StackPanel x:Name="DetailFields" Grid.Column="1" Margin="18,0,0,0" />
                            </Grid>

                            <TextBlock x:Name="DetailBodyHeader" Text="正文" FontSize="17" FontWeight="Medium"
                                       Margin="0,22,0,10" Visibility="Collapsed" />
                            <TextBlock x:Name="DetailBody" TextWrapping="Wrap" FontSize="13.5" LineHeight="23"
                                       LineStackingStrategy="BlockLineHeight" Visibility="Collapsed" />

                            <TextBlock x:Name="DetailOthersHeader" FontSize="17" FontWeight="Medium"
                                       Margin="0,22,0,10" Visibility="Collapsed" />
                            <ItemsControl x:Name="DetailOthers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1B1B22" BorderThickness="1" CornerRadius="6"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                Padding="9,6" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 网盘链接（作品本体放在谷歌网盘上时）：行由代码生成，每行一个可点的链接 -->
                            <TextBlock x:Name="DetailLinksHeader" FontSize="17" FontWeight="Medium"
                                       Margin="0,22,0,10" Visibility="Collapsed" />
                            <StackPanel x:Name="DetailLinks" />
                            <TextBlock x:Name="DetailLinksNote" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="Collapsed" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 作家监控（对齐 Web 的 fbWatchPane）：总开关 + 立即检查全部 + 默认间隔，下面一位作家一张卡。
                 卡片由代码生成（WatchList），版式同 Web 的 .libcard。 -->
            <ScrollViewer x:Name="WatchPane" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="WatchSwitchButton" MinWidth="124"
                                Click="WatchSwitch_Click" Content="自动监控：开" />
                        <Button x:Name="WatchCheckAllButton" MinWidth="110" Margin="8,0,0,0"
                                Click="WatchCheckAll_Click" Content="立即检查全部" />
                        <TextBlock x:Name="WatchDefaultLabel" Text="默认间隔" VerticalAlignment="Center"
                                   Margin="16,0,8,0" Style="{StaticResource CaptionText}" />
                        <ComboBox x:Name="WatchDefaultIntervalBox" Width="110" VerticalContentAlignment="Center"
                                  SelectionChanged="WatchDefaultInterval_SelectionChanged" />
                    </StackPanel>
                    <TextBlock x:Name="WatchStatusText" Style="{StaticResource CaptionText}"
                               Margin="2,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="WatchEmptyText" Style="{StaticResource CaptionText}"
                               Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <StackPanel x:Name="WatchList" />
                    <TextBlock x:Name="WatchNoteText" Style="{StaticResource CaptionText}"
                               Margin="2,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- 加载遮罩 -->
            <Border x:Name="LoadingOverlay" Background="#96000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="6"
                                 Foreground="{StaticResource AccentLightBrush}" />
                    <TextBlock x:Name="LoadingText" Text="正在查询…" Margin="0,12,0,0"
                               HorizontalAlignment="Center" Foreground="#e6e9f0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
